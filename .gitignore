/data4sim/
/prepared_dataset/
/sionna_result/
/NN_result/
/experiment/results/
/experiment/results_*/
/sumo_data/*
!/sumo_data/road.net.xml
!/sumo_data/road_Lbd1.00.rou.xml
!/sumo_data/road_Lbd1.00.sumocfg
!/sumo_data/vtypes.add.xml
*.pkl
*.pickle
*.npy
*.npz
*.pt
*.pth
*.h5
*.hdf5
*.ckpt
/save*/
/plots/
/old_*
/_scene_from_sionna_old.xml

# Locally archived recovery copies are preserved, not bulk-added.
/archive/
/notebooks/legacy/mox.ipynb
.ipynb_checkpoints/
__pycache__/
*.py[cod]
*.nbc
*.nbi
_tmp*/
.pytest_cache/
.ruff_cache/
build/
/latexCodes/revision1/
/latexCodes/main*.pdf
/response_letter/response_letter.pdf
# External reading/annotation assets are local backups, not source dependencies.
/response_letter/literature/*.pdf
/response_letter/review_notes/*.pdf
/response_letter/submission_support/*.png

